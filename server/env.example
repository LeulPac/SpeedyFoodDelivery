# Server port
PORT=5000

# JWT
JWT_SECRET=change_me_to_a_long_random_string

# Postgres connection (used by db.js and setupDb.js)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# IMPORTANT:
# - `setupDb.js` creates/uses a database named `food_delivery`
# - set DB_NAME accordingly so the running server connects to the same DB
DB_NAME=food_delivery

# Google Sign-In (same Client ID as customer/.env VITE_GOOGLE_CLIENT_ID)
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Chapa Payment Gateway
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=
