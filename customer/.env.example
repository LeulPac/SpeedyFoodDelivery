VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Live Vercel or custom domain for the Owner/Admin console
VITE_OWNER_PORTAL_URL=https://speedyfooddelivery-admin.vercel.app
VITE_DRIVER_PORTAL_URL=https://speedyfooddelivery-drivers.vercel.app
